# Port to run the server on
PORT=5000

# SQLite database file name (relative to backend root)
DB_FILE=database.sqlite

# Runtime environment: "production" masks 5xx error details from clients.
NODE_ENV=development

# Secret key used for signing JWT authentication tokens.
# SECURITY: must be a random string >= 32 characters (64 recommended).
# NEVER commit a real secret here. Generate one locally with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Comma-separated list of allowed CORS origins (the frontend URLs).
# Never use "*" in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Number of trusted reverse-proxy hops (for correct req.ip / rate limiting).
# 1 = single load balancer (nginx/ALB). 0 = direct exposure.
TRUST_PROXY_HOPS=1

# Base URL of the React frontend application (for links in emails/PDFs)
FRONTEND_URL=http://localhost:5173

# --- SMTP Transactional Email Configuration ---
# Leaving SMTP_USER and SMTP_PASS empty will automatically generate
# an Ethereal development mailer account on startup for testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Instituto Superior del Norte LMS <noreply@institutosuperiordelnorte.co>"
