# Frontend environment variables (Vite).
# Copy this file to `.env` and adjust. Only variables prefixed with VITE_ are
# exposed to the browser bundle — NEVER put secrets here.

# Base URL of the backend API. MUST be set to the production API URL when
# building for deployment (absolute URL, HTTPS).
# Example: https://api.institutosuperiordelnorte.co/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: target used only by the Vite dev proxy (server-side, not bundled).
VITE_API_PROXY_TARGET=http://localhost:5000
